cat << 'EOF' > .gitignore
# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build & Coverage Outputs
dist/
build/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF

devOps_notes.txt